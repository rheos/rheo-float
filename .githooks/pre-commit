#!/bin/sh
# Blocks a commit whose staged files look like private data (FR-45).
# Enable once per clone (worktrees share it): git config core.hooksPath .githooks
set -eu
root=$(git rev-parse --show-toplevel)
# The check needs Python 3.11+ (tomllib). Prefer the project venv; macOS python3 is older.
if [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" "$root/scripts/repo_check.py" --staged
fi
if command -v uv >/dev/null 2>&1; then
    exec uv run --no-sync --project "$root" python "$root/scripts/repo_check.py" --staged
fi
exec python3 "$root/scripts/repo_check.py" --staged
