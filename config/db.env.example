# The keys of $FINANCE_DATA_DIR/db.env (default ~/Finances/db.env). `finance db up` writes
# that file, mode 0600, with generated passwords when it is missing. Never commit real values.
#
# POSTGRES_PASSWORD   the container superuser's password (used by the image at first start)
# FINANCE_OWNER_DSN   postgresql://finance_owner:<password>@127.0.0.1:55440/finance
# FINANCE_READER_DSN  postgresql://finance_reader:<password>@127.0.0.1:55440/finance
POSTGRES_PASSWORD=
FINANCE_OWNER_DSN=
FINANCE_READER_DSN=
